# LlamaNet Gateway — environment configuration
# Copy to .env and fill in your values. Never commit .env.

# ── Supabase (required) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=

# ── Gateway public URL (used for OAuth redirects) ──
LLAMANET_APP_URL=https://your-gateway.example.com

# ── Server binding ──
HOST=0.0.0.0
PORT=8000
GATEWAY_PORT=8000

# ── Budgets & fairness (per API key) ──
LLAMANET_DAILY_TOKEN_BUDGET=500000
LLAMANET_MAX_KEY_CONCURRENT=3
LLAMANET_HOURLY_COMPUTE_BUDGET=10000

# ── Node quality gate (off for mixed hardware, on for curated pools) ──
LLAMANET_REQUIRE_GPU=false
LLAMANET_MIN_TPS=0.1
LLAMANET_MAX_TTFT=30
LLAMANET_MAX_LATENCY=60

# ── Logging ──
LOG_LEVEL=info
