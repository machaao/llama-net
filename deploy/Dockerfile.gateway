# LlamaNet Gateway — lightweight image (no GPU/CUDA)
# Build:  docker build -f deploy/Dockerfile.gateway -t llamanet-gateway .
# Run:    see docker-compose.gateway.yml

FROM python:3.11-slim

WORKDIR /app

# System deps (git for editable install)
RUN apt-get update && apt-get install -y --no-install-recommends git curl \
    && rm -rf /var/lib/apt/lists/*

# Dependency layer (cached)
COPY requirements.txt setup.py pyproject.toml ./
RUN pip install --no-cache-dir -r requirements.txt

# Source
COPY . .
RUN pip install --no-cache-dir -e .

ENV HOST=0.0.0.0
ENV PORT=8000
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["python", "-m", "gateway.server"]
